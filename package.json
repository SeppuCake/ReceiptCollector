{
  "name": "receipt-collector",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.15.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run ocr:prepare && vite",
    "build": "npm run ocr:prepare && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/run-playwright.mjs",
    "test:ocr": "npm run build && npm run ocr:validate-bundle && node scripts/run-playwright.mjs playwright.ocr.config.ts",
    "ocr:prepare": "node scripts/ocr/prepare-assets.mjs",
    "ocr:validate-bundle": "node scripts/ocr/validate-bundle.mjs",
    "postinstall": "npm run ocr:prepare",
    "regulatory:validate": "node scripts/regulatory/validate.mjs",
    "preview": "vite preview",
    "native:sync": "npm run build && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "native:windows:info": "tauri info",
    "verify": "npm run typecheck && npm run lint && npm test && npm run regulatory:validate && npm run build && npm run test:e2e && npm run test:ocr"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@tauri-apps/api": "2.11.1",
    "dexie": "^4.4.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
